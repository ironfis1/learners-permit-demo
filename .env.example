# Day 1: PORT is read by the app, with a local fallback of 3000.
PORT=3000

# Day 2: required for /api/recommendation to actually call Anthropic.
# Get a key from https://console.anthropic.com/ - and before this app is ever
# publicly reachable, set a hard spend/usage cap on that key in the console.
# App-level rate limiting below is a second layer, not a substitute for that.
ANTHROPIC_API_KEY=

# Day 2: signs the session cookie. Any random string works locally; use a
# real secret (e.g. `openssl rand -hex 32`) before deploying.
SESSION_SECRET=dev-secret-change-me

# Day 2: rate limits on /api/recommendation. Defaults shown - uncomment to
# override.
# RATE_LIMIT_PER_SESSION_PER_HOUR=15
# RATE_LIMIT_PER_IP_PER_HOUR=30

# Added Day 3 (Upsun-managed PostgreSQL relationship — injected automatically
# by Upsun at deploy time, not set manually):
# DATABASE_URL=
